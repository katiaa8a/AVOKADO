<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aguacate Fresh</title>

<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #f5fff5;
}

/* HEADER */
header {
  background: #2e7d32;
  color: white;
  padding: 15px;
  text-align: center;
}

nav a {
  color: white;
  margin: 0 10px;
  text-decoration: none;
  font-weight: bold;
}

/* HERO */
.hero {
  background: url('https://images.unsplash.com/photo-1607301406259-dfb186e15de8');
  background-size: cover;
  color: white;
  text-align: center;
  padding: 100px 20px;
}

.hero h1 {
  font-size: 40px;
}

/* PRODUCTOS */
.products {
  padding: 40px;
  text-align: center;
}

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
}

.card {
  background: white;
  border-radius: 15px;
  padding: 15px;
  width: 250px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.card img {
  width: 100%;
  border-radius: 10px;
}

button {
  background: #4caf50;
  color: white;
  border: none;
  padding: 10px;
  margin-top: 10px;
  border-radius: 8px;
  cursor: pointer;
}

button:hover {
  background: #2e7d32;
}

/* GUACAMOLE ESPECIAL */
#guacamole {
  background-image: url('https://img.freepik.com/fotos-premium/aguacate-sobre-fondo-madera-vista-superior-espacio-libre-su-texto_187166-24502.jpg');
  background-size: cover;
  padding: 50px;
}

.guac-box {
  background: rgba(255,255,255,0.85);
  padding: 20px;
  border-radius: 15px;
  max-width: 400px;
  margin: auto;
  text-align: center;
}

/* NOSOTROS */
.about {
  padding: 40px;
  text-align: center;
}

/* CONTACTO */
.contact {
  padding: 40px;
  text-align: center;
}

input, textarea {
  width: 80%;
  padding: 10px;
  margin: 10px;
}

/* FOOTER */
footer {
  background: #2e7d32;
  color: white;
  text-align: center;
  padding: 15px;
}

/* RESPONSIVE */
@media (max-width: 600px) {
  .cards {
    flex-direction: column;
    align-items: center;
  }
}
</style>
</head>

<body>

<header>
  <h1>Aguacate Fresh</h1>
  <nav>
    <a href="#">Inicio</a>
    <a href="#productos">Productos</a>
    <a href="#nosotros">Nosotros</a>
    <a href="#contacto">Contacto</a>
  </nav>
</header>

<section class="hero">
  <h1>Frescura en cada bocado 🥑</h1>
  <p>Productos naturales de aguacate</p>
</section>

<section id="productos" class="products">
  <h2>Productos</h2>
  <div class="cards">

    <div class="card">
      <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f">
      <h3>Dips</h3>
      <p>Deliciosos dips naturales</p>
      <button onclick="comprar('Dips')">Comprar</button>
    </div>

    <div class="card">
      <img src="https://images.unsplash.com/photo-1605478580701-1f8c3c6c5eae">
      <h3>Pulpa</h3>
      <p>Pulpa lista para usar</p>
      <button onclick="comprar('Pulpa')">Comprar</button>
    </div>

    <div class="card">
      <img src="https://images.unsplash.com/photo-1592928308033-55d4d6d08f48">
      <h3>Chips</h3>
      <p>Snacks saludables</p>
      <button onclick="comprar('Chips')">Comprar</button>
    </div>

  </div>
</section>

<section id="guacamole">
  <div class="guac-box">
    <img src="data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD/2wCEAAkGBxMSEhUSExMWFhUXGB8aGBgXGBgeGxsYGBoXGBgeGh0YHSggGh0lHRoXITEjJSkrLi4uGh8zODMtNygtLisBCgoKDg0OGxAQGy0mICYtMC0yLy0tLS0vLS8tLy0vLS0tLy0tLy0tLS0tLS0tLS0tLS0tLS0tLy0tLS0tLS0tLf/AABEIAOEA4QMBIgACEQEDEQH/xAAcAAACAgMBAQAAAAAAAAAAAAAEBQMGAAECBwj/xAA/...">
    <h2>Guacamole</h2>
    <p>Hecho con aguacates frescos</p>
    <button onclick="comprar('Guacamole')">Comprar</button>
  </div>
</section>

<section id="nosotros" class="about">
  <h2>Nosotros</h2>
  <p>Somos un negocio dedicado a ofrecer productos naturales de aguacate con la mejor calidad.</p>
</section>

<section id="contacto" class="contact">
  <h2>Contacto</h2>
  <input type="text" placeholder="Nombre"><br>
  <input type="email" placeholder="Email"><br>
  <textarea placeholder="Mensaje"></textarea><br>
  <button onclick="enviar()">Enviar</button>
</section>

<footer>
  <p>© 2026 Aguacate Fresh</p>
</footer>

<script>
function comprar(producto) {
  alert("Agregaste " + producto + " al carrito 🛒");
}

function enviar() {
  alert("Mensaje enviado 📩");
}
</script>

</body>
</html>
